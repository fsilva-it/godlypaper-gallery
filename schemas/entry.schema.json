{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsilva-it.github.io/godlypaper-gallery/schemas/entry.schema.json",
  "title": "Gallery entry (published listing)",
  "type": "object",
  "required": ["slug", "version", "type", "title", "license", "preview", "package"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "type": { "type": "string", "enum": ["video", "web"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "author": { "type": "string", "maxLength": 120 },
    "license": { "type": "string", "minLength": 3 },
    "preview": { "type": "string", "format": "uri" },
    "package": {
      "type": "object",
      "required": ["url", "sha256", "size"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size": { "type": "integer", "minimum": 1, "maximum": 157286400 }
      },
      "additionalProperties": false
    },
    "tags": { "type": "array", "items": { "type": "string", "maxLength": 32 }, "maxItems": 12 },
    "contentRating": { "type": "string", "enum": ["everyone"] },
    "minAppVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "downloads": { "type": "integer", "minimum": 0 },
    "publishedAt": { "type": "string" },
    "submittedBy": { "type": "string" }
  },
  "additionalProperties": false
}
