{
  "schema": 1,
  "id": "minimal-clock",
  "version": "1.0.0",
  "type": "web",
  "title": "Minimal Clock",
  "author": { "name": "GodlyPaper", "url": "https://github.com/godlypaper" },
  "license": "CC0-1.0",
  "entry": "index.html",
  "preview": "preview.jpg",
  "tags": ["clock", "minimal", "time"],
  "contentRating": "everyone",
  "web": { "allowNetwork": false },
  "properties": {
    "textcolor":   { "type": "color", "label": "Text color",      "order": 0, "default": "0.92 0.94 0.96" },
